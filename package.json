{
  "name": "resilireplay-monorepo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Crash-test AI agents and MCP servers, replay failures, and turn broken traces into deterministic regression tests.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm build && pnpm -r --sort typecheck && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "demo": "node scripts/demo.mjs",
    "demo:mcp": "node scripts/mcp-demo.mjs",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "hygiene:scan": "node scripts/hygiene-scan.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm package:smoke && pnpm secret:scan && pnpm hygiene:scan"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@resilireplay/core": "workspace:*",
    "@resilireplay/mcp-chaos": "workspace:*",
    "@resilireplay/reporters": "workspace:*",
    "@resilireplay/trace": "workspace:*",
    "@types/node": "26.1.2",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "resilireplay": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
