{
  "name": "resilireplay-monorepo",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Turn reviewed MCP failures into deterministic recovery evidence and executable regression tests.",
  "author": "Ali <268342250+aliengineering-byte@users.noreply.github.com>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "typecheck": "pnpm build && pnpm -r --sort typecheck && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "demo": "node scripts/demo.mjs",
    "demo:mcp": "node scripts/mcp-demo.mjs",
    "demo:studio": "node scripts/studio-demo.mjs",
    "demo:agent": "node scripts/agent-demo.mjs",
    "mcp:inspector:verify": "node scripts/verify-official-inspector.mjs",
    "capture:studio": "node scripts/capture-studio-demo.mjs",
    "capture:field": "node scripts/capture-field-evidence.mjs",
    "field:verify": "node scripts/verify-field-evidence.mjs",
    "site:check": "node scripts/check-site.mjs",
    "site:test": "node scripts/site-browser-test.mjs",
    "release:gates": "node scripts/release-gates.mjs",
    "agent:gates": "node scripts/agent-release-gates.mjs",
    "agent:validate": "pnpm --filter @resilireplay/agent build && node scripts/build-plugin-runtime.mjs && node scripts/validate-agent-assets.mjs",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "fixtures:agent": "node scripts/generate-hf-fixtures.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "hygiene:scan": "node scripts/hygiene-scan.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm agent:validate && pnpm mcp:inspector:verify && pnpm field:verify && pnpm site:check && pnpm package:smoke && pnpm secret:scan && pnpm hygiene:scan && pnpm agent:gates"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.62.1",
    "@resilireplay/agent": "workspace:*",
    "@resilireplay/adapter-sdk": "workspace:*",
    "@resilireplay/campaign": "workspace:*",
    "@resilireplay/core": "workspace:*",
    "@resilireplay/mcp-chaos": "workspace:*",
    "@resilireplay/reporters": "workspace:*",
    "@resilireplay/studio": "workspace:*",
    "@resilireplay/trace": "workspace:*",
    "@types/node": "20.19.9",
    "@typescript-eslint/eslint-plugin": "8.38.0",
    "@typescript-eslint/parser": "8.38.0",
    "@vitest/coverage-v8": "3.2.4",
    "axe-core": "4.12.1",
    "esbuild": "0.28.1",
    "eslint": "9.32.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "resilireplay": "workspace:*",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
