{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aliengineering-byte/resilireplay/blob/v0.5.0/schemas/capture-session.v1.schema.json",
  "title": "ResiliReplay Capture Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "status",
    "startedAt",
    "eventCount",
    "failureCount",
    "limits"
  ],
  "properties": {
    "schemaVersion": { "const": "resilireplay.capture-session/v1" },
    "sessionId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["armed", "stopped"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "stoppedAt": { "type": "string", "format": "date-time" },
    "eventCount": { "type": "integer", "minimum": 0, "maximum": 20000 },
    "failureCount": { "type": "integer", "minimum": 0, "maximum": 20000 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxEvents", "maxEventBytes"],
      "properties": { "maxEvents": { "const": 20000 }, "maxEventBytes": { "const": 32768 } }
    }
  }
}
