{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliengineering-byte.github.io/resilireplay/standards/mcp-res/v0.2.0/schemas/attestation-statement.schema.json",
  "title": "MCP-RES in-toto statement and predicate v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://aliengineering-byte.github.io/resilireplay/standards/mcp-res/attestation/v0.2"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceBundleDigest",
        "scenarioFingerprint",
        "executionInstanceDigest",
        "profile",
        "validator",
        "signerIdentity",
        "signerKeyFingerprint",
        "signatureAlgorithm",
        "signingTime",
        "trustPolicyId"
      ],
      "properties": {
        "evidenceBundleDigest": { "$ref": "#/$defs/sha256" },
        "scenarioFingerprint": { "$ref": "#/$defs/sha256" },
        "executionInstanceDigest": { "$ref": "#/$defs/sha256" },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "pattern": "^mcp-res/[a-z0-9-]+/v[1-9][0-9]*$" },
            "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" }
          }
        },
        "validator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "sha256"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 96 },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "signerIdentity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "signerKeyFingerprint": { "$ref": "#/$defs/sha256" },
        "signatureAlgorithm": { "const": "Ed25519" },
        "signingTime": { "type": "string", "format": "date-time" },
        "trustPolicyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "transparencyReference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logId", "entryUuid", "inclusionProofBase64", "inclusionProofSha256"],
          "properties": {
            "logId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "entryUuid": { "type": "string", "minLength": 1, "maxLength": 256 },
            "inclusionProofBase64": { "type": "string", "minLength": 4, "maxLength": 1048576 },
            "inclusionProofSha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
