{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliengineering-byte.github.io/resilireplay/standards/mcp-res/v0.2.0/schemas/oauth-boundary-evaluation.schema.json",
  "title": "MCP-RES OAuth boundary evaluation v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subject",
    "environment",
    "profile",
    "fixture",
    "flow",
    "cases",
    "privacy",
    "cleanup",
    "result",
    "evaluationSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "mcp-res.oauth-boundary-evaluation/0.2.0" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifactSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "runtime", "runtimeVersion"],
      "properties": {
        "platform": { "enum": ["linux", "win32", "darwin"] },
        "runtime": { "enum": ["node", "python", "other"] },
        "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifestSha256", "protocolRevision"],
      "properties": {
        "id": { "const": "mcp-res/oauth-boundary/v1" },
        "version": { "const": "1.0.0" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "protocolRevision": { "enum": ["2025-11-25", "2026-07-28"] }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loopbackOnly",
        "syntheticCredentials",
        "realAuthorizationProvidersContacted",
        "externalNetworkRequests",
        "listenerSha256"
      ],
      "properties": {
        "loopbackOnly": { "type": "boolean" },
        "syntheticCredentials": { "type": "boolean" },
        "realAuthorizationProvidersContacted": { "type": "integer", "minimum": 0 },
        "externalNetworkRequests": { "type": "integer", "minimum": 0 },
        "listenerSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceUri",
        "authorizationServerIssuer",
        "authorizationEndpoint",
        "tokenEndpoint",
        "clientId",
        "redirectUri",
        "requestedScopes",
        "authorizedScopes",
        "codeChallengeMethod",
        "cimdSha256",
        "trustPolicyId"
      ],
      "properties": {
        "resourceUri": { "type": "string", "format": "uri", "maxLength": 512 },
        "authorizationServerIssuer": { "type": "string", "format": "uri", "maxLength": 512 },
        "authorizationEndpoint": { "type": "string", "format": "uri", "maxLength": 512 },
        "tokenEndpoint": { "type": "string", "format": "uri", "maxLength": 512 },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "redirectUri": { "type": "string", "format": "uri", "maxLength": 512 },
        "requestedScopes": { "$ref": "#/$defs/scopes" },
        "authorizedScopes": { "$ref": "#/$defs/scopes" },
        "codeChallengeMethod": { "const": "S256" },
        "cimdSha256": { "$ref": "#/$defs/sha256" },
        "trustPolicyId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidenceSource", "positive", "negative", "wrongReasonMutant"],
        "properties": {
          "id": { "$ref": "#/$defs/checkId" },
          "evidenceSource": { "enum": ["RUNTIME_PROBE", "TEST_FIXTURE"] },
          "positive": { "$ref": "#/$defs/observation" },
          "negative": { "$ref": "#/$defs/observation" },
          "wrongReasonMutant": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "propertyReached",
              "observedReasonCode",
              "expectedDiagnostic",
              "artifactSha256"
            ],
            "properties": {
              "propertyReached": { "type": "boolean" },
              "observedReasonCode": { "$ref": "#/$defs/reason" },
              "expectedDiagnostic": { "const": "MCP_RES_OAUTH_WRONG_REASON" },
              "artifactSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenMaterialPersisted",
        "evidenceContainsCredentialMaterial",
        "authorizationErrorsSanitized"
      ],
      "properties": {
        "tokenMaterialPersisted": { "type": "boolean" },
        "evidenceContainsCredentialMaterial": { "type": "boolean" },
        "authorizationErrorsSanitized": { "type": "boolean" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listenerClosed", "redirectListenerReleased", "observationSha256"],
      "properties": {
        "listenerClosed": { "type": "boolean" },
        "redirectListenerReleased": { "type": "boolean" },
        "observationSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "result": { "enum": ["PASS", "FAIL", "INCOMPLETE"] },
    "evaluationSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checkId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
    "reason": { "type": "string", "pattern": "^MCP_RES_OAUTH_[A-Z0-9_]{3,120}$" },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9._:-]{1,128}$" }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "propertyReached",
        "expectedOutcome",
        "observedOutcome",
        "expectedReasonCode",
        "observedReasonCode",
        "artifactSha256"
      ],
      "properties": {
        "propertyReached": { "type": "boolean" },
        "expectedOutcome": { "enum": ["ACCEPT", "REJECT"] },
        "observedOutcome": { "enum": ["ACCEPT", "REJECT", "NOT_OBSERVED"] },
        "expectedReasonCode": { "$ref": "#/$defs/reason" },
        "observedReasonCode": { "$ref": "#/$defs/reason" },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
