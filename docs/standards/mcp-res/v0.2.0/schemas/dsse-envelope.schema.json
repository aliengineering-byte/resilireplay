{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliengineering-byte.github.io/resilireplay/standards/mcp-res/v0.2.0/schemas/dsse-envelope.schema.json",
  "title": "MCP-RES DSSE envelope v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "payloadType", "payload", "signatures"],
  "properties": {
    "schemaVersion": { "const": "mcp-res.dsse-envelope/0.2.0" },
    "payloadType": { "const": "application/vnd.in-toto+json" },
    "payload": { "type": "string", "minLength": 4, "maxLength": 1048576 },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "sig", "algorithm", "publicKeySpkiBase64", "signerIdentity"],
        "properties": {
          "keyid": { "$ref": "#/$defs/sha256" },
          "sig": { "type": "string", "minLength": 4, "maxLength": 4096 },
          "algorithm": { "const": "Ed25519" },
          "publicKeySpkiBase64": { "type": "string", "minLength": 4, "maxLength": 4096 },
          "signerIdentity": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
