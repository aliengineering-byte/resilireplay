{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliengineering-byte.github.io/resilireplay/standards/mcp-res/v0.2.0/schemas/integrity-manifest.schema.json",
  "title": "MCP-RES integrity manifest v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalizationAlgorithm",
    "hashAlgorithm",
    "publication",
    "complete",
    "artifacts",
    "bundleDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "mcp-res.integrity-manifest/0.2.0" },
    "canonicalizationAlgorithm": { "const": "mcp-res-json-utf16-v1" },
    "hashAlgorithm": { "const": "SHA-256" },
    "publication": { "const": "MANIFEST_LAST" },
    "complete": { "const": true },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "bundleDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
