{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliengineering-byte.github.io/resilireplay/standards/mcp-res/v0.2.0/schemas/profile-evaluation.schema.json",
  "title": "MCP-RES bounded reliability profile evaluation v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subject",
    "environment",
    "profile",
    "scope",
    "checks",
    "cleanup",
    "result",
    "evaluationSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "mcp-res.profile-evaluation/0.2.0" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "implementationLanguage", "version", "artifactSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "implementationLanguage": { "enum": ["TYPESCRIPT", "PYTHON", "OTHER"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "runtimeName", "runtimeVersion"],
      "properties": {
        "platform": { "enum": ["linux", "win32", "darwin"] },
        "runtimeName": { "enum": ["node", "python", "other"] },
        "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifestSha256", "protocolRevision"],
      "properties": {
        "id": { "type": "string", "pattern": "^mcp-res/[a-z0-9-]+/v1$" },
        "version": { "const": "1.0.0" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "protocolRevision": { "enum": ["2025-11-25", "2026-07-28"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "claimedCheckIds", "targetKind", "targetSha256", "remoteOptIn"],
      "properties": {
        "claim": { "enum": ["FULL_PROFILE", "BOUNDED_CHECK_SET"] },
        "claimedCheckIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" }
        },
        "targetKind": { "enum": ["LOCAL_STDIO", "LOOPBACK_HTTP", "OFFLINE_MODEL", "REMOTE_HTTP"] },
        "targetSha256": { "$ref": "#/$defs/sha256" },
        "remoteOptIn": { "type": "boolean" },
        "allowlistSha256": { "$ref": "#/$defs/sha256" },
        "reviewedTargetSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "positive", "negativeControl"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$" },
          "positive": { "$ref": "#/$defs/observation" },
          "negativeControl": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "observed", "observationSha256"],
      "properties": {
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "observationSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "result": { "enum": ["PASS", "FAIL", "INCOMPLETE"] },
    "evaluationSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "propertyReached",
        "expectedOutcome",
        "observedOutcome",
        "expectedReasonCode",
        "observedReasonCode",
        "artifactSha256"
      ],
      "properties": {
        "source": { "enum": ["RUNTIME_PROBE", "SANITIZED_OFFICIAL_OUTPUT", "TEST_FIXTURE"] },
        "propertyReached": { "type": "boolean" },
        "expectedOutcome": { "enum": ["ACCEPT", "REJECT", "TERMINATE", "NO_EFFECT"] },
        "observedOutcome": {
          "enum": ["ACCEPT", "REJECT", "TERMINATE", "NO_EFFECT", "NOT_OBSERVED"]
        },
        "expectedReasonCode": { "type": "string", "pattern": "^MCP_RES_[A-Z0-9_]{3,120}$" },
        "observedReasonCode": { "type": "string", "pattern": "^MCP_RES_[A-Z0-9_]{3,120}$" },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
