{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aliengineering-byte.github.io/resilireplay/standards/mcp-res/v0.1.0/schemas/profile-manifest.schema.json",
  "title": "MCP-RES profile manifest v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "subjectTypes",
    "evidenceClasses",
    "requirements",
    "negativeControls",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "mcp-res.profile-manifest/0.1.0" },
    "id": { "type": "string", "pattern": "^mcp-res/[a-z0-9-]+/v[1-9][0-9]*$", "maxLength": 128 },
    "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["NORMATIVE", "PROVISIONAL", "EXPERIMENTAL"] },
    "subjectTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "MCP_SERVER",
          "MCP_CLIENT",
          "AGENT_RUNTIME",
          "GATEWAY_PROXY",
          "ADAPTER",
          "TRANSPORT_IMPLEMENTATION",
          "TEST_HARNESS"
        ]
      }
    },
    "evidenceClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "GENUINE_RUNTIME",
          "FIXTURE_BACKED_PROTOCOL",
          "FIXTURE_VERIFIED",
          "INSTALLATION_VERIFIED",
          "DOCUMENTED_ONLY"
        ]
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^MCPRES-[A-Z]+-[0-9]{3}$" }
    },
    "negativeControls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  }
}
