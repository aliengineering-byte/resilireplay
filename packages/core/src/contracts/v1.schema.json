{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilireplay.dev/contracts/event-v1.schema.json",
  "title": "ResiliReplay Event Envelope v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "envelopeVersion",
    "eventId",
    "runId",
    "traceId",
    "spanId",
    "sequence",
    "turnId",
    "actorId",
    "framework",
    "frameworkVersion",
    "adapter",
    "adapterVersion",
    "operation",
    "boundary",
    "phase",
    "eventKind",
    "attempt",
    "eventClass",
    "safetyClass",
    "payloadDigest",
    "redaction",
    "wallClock",
    "payload",
    "metadata"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "envelopeVersion": { "type": "number", "const": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "minLength": 1 },
    "spanId": { "type": "string", "minLength": 1 },
    "parentSpanId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "turnId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "framework": { "type": "string", "minLength": 1 },
    "frameworkVersion": { "type": "string", "minLength": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "boundary": {
      "type": "string",
      "enum": ["framework", "model", "tool", "transport", "stream", "checkpoint", "state", "side_effect", "unknown"]
    },
    "phase": {
      "type": "string",
      "enum": ["start", "running", "error", "retry", "succeeded", "cancelled", "skipped", "abort", "unknown"]
    },
    "eventKind": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 0 },
    "eventClass": {
      "type": "string",
      "enum": [
        "run", "agent", "turn", "model", "tool", "stream", "handoff", "guardrail", "checkpoint", "state", "interrupt", "retry", "side_effect", "recovery", "custom"
      ]
    },
    "safetyClass": { "type": "string", "enum": ["safe", "unsafe", "unknown"] },
    "payloadDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "wallClock": { "type": "string", "format": "date-time" },
    "redaction": {
      "type": "object",
      "required": ["strategy", "fieldsRemoved", "fieldsMasked"],
      "properties": {
        "strategy": { "type": "string", "enum": ["redacted", "masked", "none"] },
        "fieldsRemoved": { "type": "array", "items": { "type": "string" } },
        "fieldsMasked": { "type": "array", "items": { "type": "string" } },
        "version": { "type": "string" }
      }
    },
    "payload": {},
    "metadata": { "type": "object", "additionalProperties": true },
    "deterministicSeed": { "type": "integer" },
    "sideEffect": { "type": "object" },
    "causeId": { "type": "string" },
    "parentEventId": { "type": "string" }
  },
  "additionalProperties": false
}
